+class ApplicantNoteLabelImportTests(SimpleTestCase):
+    def test_builder_processing_normalizes_labels_and_preserves_body_formatting(self):
+        html = (
+            "<h1>Opportunity</h1><h2>Summary</h2>"
+            "<p>PLEASE NOTE: Apply by <em>Friday</em>.</p>"
+            '<p><em>Note</em> <b>–</b> <a href="https://example.org">Read more</a>.</p>'
+            "<p><b>N.B. Keep this bold.</b></p>"
+            "<p><strong>Note:</strong> Already standardized.</p>"
+            "<table><tr><th>Instructions</th></tr>"
+            "<tr><td><p>n.b. Keep <strong>this</strong> in the table.</p>"
+            "<p>Keep the next paragraph.</p></td></tr></table>"
+        )
+        result = content_processing.process_document_content(html, builder_import=True)
+        self.assertEqual(
+            [paragraph.decode_contents() for paragraph in result.soup.find_all("p")],
+            [
+                "<strong>Note:</strong> Apply by <em>Friday</em>.",
+                '<strong>Note:</strong> <a href="https://example.org">Read more</a>.',
+                "<strong>Note:</strong><b> Keep this bold.</b>",
+                "<strong>Note:</strong> Already standardized.",
+                "<strong>Note:</strong> Keep <strong>this</strong> in the table.",
+                "Keep the next paragraph.",
+            ],
+        )
+        body = get_as_markdown(result.sections[0]["subsections"][0]["body"])
+        self.assertIn("**Note:** Apply by *Friday*.", body)
+        self.assertIn("**Note:** [Read more](https://example.org).", body)
+        self.assertIn("**Note:** **Keep this bold.**", body)
+        self.assertIn(
+            "<strong>Note:</strong> Keep <strong>this</strong> in the table.", body
+        )
+
+    def test_import_preserves_a_bookmark_before_the_label(self):
+        result = content_processing.process_document_content(
+            "<h1>Opportunity</h1><h2>Summary</h2>"
+            '<p><a href="#deadline-note">See deadline</a></p>'
+            '<p><a id="deadline-note"></a>Note – Apply by Friday.</p>'
+        )
+        bookmark = result.soup.find(id="deadline-note")
+        self.assertEqual(bookmark.find_next_sibling("strong").get_text(), "Note:")
+        self.assertEqual(bookmark.parent.get_text(), "Note: Apply by Friday.")
+
+    def test_import_leaves_ordinary_prose_and_embedded_labels_alone(self):
+        cases = [
+            "Note that the deadline changed.",
+            "Note-taking is optional.",
+            "Please note the new schedule.",
+            "Apply by Friday. Note: Late applications are ineligible.",
+            "Apply now.<br/>N.B. Read the instructions.",
+            "N.B.C. is an organization.",
+        ]
+        for source in cases:
+            with self.subTest(source=source):
+                soup, _ = process_nofo_html(
+                    BeautifulSoup(f"<p>{source}</p>", "html.parser"), "h1"
+                )
+                self.assertEqual(soup.p.decode_contents(), source)
