+_APPLICANT_NOTE_LABEL = re.compile(
+    r"\A\s*(?:(?:please\s+)?note(?:\s*[:–—]|\s+-|-(?=\s|$))"
+    r"|n\.b\.(?:\s*[:–—-]|(?=\s|$)))",
+    re.IGNORECASE,
+)
+_NOTE_LABEL_FORMATTING_TAGS = {"b", "em", "i", "span", "strong", "u"}
+
+
+def normalize_applicant_note_labels(soup):
+    """Replace a paragraph's label, preserving the inline markup of its body."""
+    for paragraph in soup.find_all("p"):
+        prefix_nodes = []
+        for node in paragraph.descendants:
+            if type(node) is NavigableString:
+                prefix_nodes.append(node)
+            elif isinstance(node, Comment) or (
+                isinstance(node, Tag)
+                and node.name == "a"
+                and not node.contents
+                and (node.has_attr("id") or node.has_attr("name"))
+            ):
+                continue
+            elif (
+                not isinstance(node, Tag)
+                or node.name not in _NOTE_LABEL_FORMATTING_TAGS
+            ):
+                # A link, image, break, or other content marks the end of the prefix.
+                break
+
+        match = _APPLICANT_NOTE_LABEL.match("".join(prefix_nodes))
+        if match is None:
+            continue
+
+        first_label_node = next(node for node in prefix_nodes if node.strip())
+        while first_label_node.parent is not paragraph:
+            first_label_node = first_label_node.parent
+        label = soup.new_tag("strong")
+        label.string = "Note:"
+        first_label_node.insert_before(label)
+
+        remaining = match.end()
+        for node in prefix_nodes:
+            if remaining < len(node):
+                node.replace_with(node[remaining:])
+                break
+            remaining -= len(node)
+            parent = node.parent
+            node.extract()
+            while parent is not paragraph and not parent.contents and not parent.attrs:
+                empty = parent
+                parent = empty.parent
+                empty.decompose()
+            if remaining == 0:
+                break
+
+
