+class ApplicantNoteImportTests(SimpleTestCase):
+    def test_import_normalizes_labels_and_preserves_the_body(self):
+        cases = [
+            (
+                'PLEASE NOTE: Read the <a href="https://example.org">guide</a>.',
+                '<strong>Note:</strong> Read the <a href="https://example.org">guide</a>.',
+            ),
+            (
+                "<em>Note – Text remains italic.</em>",
+                "<strong>Note:</strong><em> Text remains italic.</em>",
+            ),
+            (
+                "<strong>N.</strong><span>B.</span> <em>Apply by Friday.</em>",
+                "<strong>Note:</strong> <em>Apply by Friday.</em>",
+            ),
+            ("<b>note</b>:Apply.", "<strong>Note:</strong> Apply."),
+            (
+                "<strong>Note:</strong> Already canonical.",
+                "<strong>Note:</strong> Already canonical.",
+            ),
+        ]
+        for source, expected in cases:
+            with self.subTest(source=source):
+                html = f"<h1>Opportunity</h1><p>{source}</p>"
+                result = content_processing.process_document_content(
+                    html, builder_import=True
+                )
+                self.assertEqual(result.soup.p.decode_contents(), expected)
+
+                repeated = content_processing.process_document_content(
+                    str(result.soup), builder_import=True
+                )
+                self.assertEqual(repeated.soup.p.decode_contents(), expected)
+
+    def test_import_normalizes_table_paragraphs_before_markdown_conversion(self):
+        result = content_processing.process_document_content(
+            "<h1>Opportunity</h1><table>"
+            "<tr><td>Requirement</td><td>Details</td></tr>"
+            "<tr><td>Deadline</td><td><p>Note – Apply <em>early</em>.</p></td></tr>"
+            "</table>",
+            builder_import=True,
+        )
+        self.assertEqual(
+            result.soup.select_one("tr:last-child td:last-child p").decode_contents(),
+            "<strong>Note:</strong> Apply <em>early</em>.",
+        )
+        self.assertIn(
+            "**Note:** Apply *early*.", content_processing.md(str(result.soup.table))
+        )
+
+    def test_import_leaves_sentences_and_embedded_labels_alone(self):
+        cases = [
+            "Please note that applications close Friday.",
+            "Note the updated deadline.",
+            "Note-worthy changes are listed below.",
+            "A reminder. PLEASE NOTE: Bring identification.",
+            "<br/>Note: A later line.",
+            "N.B.A. is an acronym.",
+        ]
+        for source in cases:
+            with self.subTest(source=source):
+                result = content_processing.process_document_content(
+                    f"<h1>Opportunity</h1><p>{source}</p>", builder_import=True
+                )
+                self.assertEqual(result.soup.p.decode_contents(), source)
