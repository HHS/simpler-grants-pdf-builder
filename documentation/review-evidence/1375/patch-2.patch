+_APPLICANT_NOTE_LABEL = re.compile(
+    r"^\s*(?:(?:please\s+note|note)\s*(?:[:–—]|-(?=\s|$))"
+    r"|n\.b\.(?![\w.])(?:\s*[:–—-])?)",
+    re.IGNORECASE,
+)
+
+
+def normalize_applicant_note_labels(soup):
+    """Replace a leading note label while keeping the paragraph's remaining nodes."""
+    inline_tags = {"a", "b", "em", "i", "span", "strong", "sub", "sup", "u"}
+    for paragraph in soup.find_all("p"):
+        text_nodes = []
+        for node in paragraph.descendants:
+            if type(node) is NavigableString:
+                text_nodes.append(node)
+            elif isinstance(node, Tag) and node.name not in inline_tags:
+                break
+
+        text = "".join(text_nodes)
+        match = _APPLICANT_NOTE_LABEL.match(text)
+        if match is None:
+            continue
+
+        remaining = match.end()
+        for node in text_nodes:
+            if len(node) > remaining:
+                node.replace_with(node[remaining:])
+                break
+
+            remaining -= len(node)
+            parent = node.parent
+            node.extract()
+            while parent is not paragraph and not parent.contents:
+                if parent.has_attr("id") or parent.has_attr("name"):
+                    break
+                empty = parent
+                parent = empty.parent
+                empty.decompose()
+            if remaining == 0:
+                break
+
+        label = soup.new_tag("strong")
+        label.string = "Note:"
+        paragraph.insert(0, label)
+        if match.end() < len(text) and not text[match.end()].isspace():
+            label.insert_after(" ")
+
+
