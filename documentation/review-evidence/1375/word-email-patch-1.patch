+++ b/nofos/nofos/tests_nofos/test_word_email_links.py
@@ -0,0 +1,98 @@
+from unittest.mock import patch
+from xml.sax.saxutils import escape, quoteattr
+
+import markdown
+from bs4 import BeautifulSoup
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import SimpleTestCase
+
+from nofos.nofo import parse_uploaded_file_as_html_string
+from nofos.nofo_markdown import md
+from nofos.tests_nofos.test_word_lists import docx, paragraph
+
+
+class WordEmailLinkTests(SimpleTestCase):
+    @patch("nofos.nofo.config", WORD_IMPORT_STRICT_MODE=False)
+    def test_repairs_only_file_urls_with_an_exact_email_label(self, _config):
+        examples = [
+            (
+                "file:///Users/writer/Contact%2BGrants%40example.org",
+                "Contact+Grants@example.org",
+                "mailto:Contact+Grants@example.org",
+            ),
+            (
+                r"file:///C:\Users\writer\person@example.org",
+                "person@example.org",
+                "mailto:person@example.org",
+            ),
+            ("mailto:other@example.org", "Contact us", None),
+            ("https://example.org/person@example.org", "person@example.org", None),
+            ("file:///temp/guide.pdf", "guide.pdf", None),
+            ("file:///temp/person@example.org", "Contact us", None),
+            ("file:///temp/person@example.org", "Person@example.org", None),
+            ("file:///temp/person@example.org", " person@example.org", None),
+            ("file:///temp/person@example.org?download=1", "person@example.org", None),
+            ("file:///temp/person@example.org#contact", "person@example.org", None),
+            ("file:///temp/person@example.org?", "person@example.org", None),
+            ("file:///temp/person@example.org#", "person@example.org", None),
+            ("file:///temp/person@example.org/", "person@example.org", None),
+        ]
+        relationship_namespace = (
+            "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
+        )
+        relationships = []
+        paragraphs = []
+        for index, (href, label, _) in enumerate(examples):
+            relationships.append(
+                f'<Relationship Id="link{index}" Type="{relationship_namespace}/hyperlink" '
+                f'Target={quoteattr(href)} TargetMode="External"/>'
+            )
+            label_start, separator, label_end = label.partition("@")
+            runs = (
+                '<w:r><w:rPr><w:i/></w:rPr><w:t xml:space="preserve">'
+                f"{escape(label_start)}</w:t></w:r>"
+                f"<w:r><w:t>{escape(separator + label_end)}</w:t></w:r>"
+            )
+            paragraphs.append(
+                paragraph(
+                    "",
+                    num=None,
+                    runs=f'<w:hyperlink r:id="link{index}">{runs}</w:hyperlink>',
+                )
+            )
+        source = docx(
+            "".join(paragraphs),
+            extra={
+                "word/_rels/document.xml.rels": (
+                    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
+                    + "".join(relationships)
+                    + "</Relationships>"
+                )
+            },
+        )
+        upload = SimpleUploadedFile(
+            "email-links.docx",
+            source.getvalue(),
+            content_type="application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+        )
+
+        html, warnings = parse_uploaded_file_as_html_string(upload)
+
+        self.assertEqual(warnings, 0)
+        links = BeautifulSoup(html, "html.parser").find_all("a")
+        self.assertEqual(
+            [(link["href"], link.get_text()) for link in links],
+            [(expected or href, label) for href, label, expected in examples],
+        )
+        self.assertEqual(links[0].em.get_text(), "Contact+Grants")
+        rendered = BeautifulSoup(markdown.markdown(md(html)), "html.parser")
+        self.assertEqual(rendered.a["href"], "mailto:Contact+Grants@example.org")
+        self.assertEqual(rendered.a.get_text(), "Contact+Grants@example.org")
+
+    def test_html_upload_bypasses_word_email_repair(self):
+        html = '<a href="file:///temp/person@example.org">person@example.org</a>'
+        upload = SimpleUploadedFile(
+            "email-links.html", html.encode(), content_type="text/html"
+        )
+
+        self.assertEqual(parse_uploaded_file_as_html_string(upload), (html, 0))
