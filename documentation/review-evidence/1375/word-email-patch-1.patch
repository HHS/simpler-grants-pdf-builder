+def _repair_word_email_links(html):
+    """Recover email links that Word saved with a file URL (IMPORT-078)."""
+    if "file:" not in html.lower():
+        return html
+
+    soup = BeautifulSoup(html, "html.parser")
+    changed = False
+    for link in soup.find_all("a", href=True):
+        href = link["href"]
+        if not href.lower().startswith("file:") or "?" in href or "#" in href:
+            continue
+
+        try:
+            path = urlsplit(href).path.replace("\\", "/")
+        except ValueError:
+            continue
+
+        address = link.get_text()
+        if unquote(path.rsplit("/", 1)[-1]) != address or link.find(["br", "img"]):
+            continue
+        try:
+            validate_email(address)
+        except ValidationError:
+            continue
+
+        link["href"] = "mailto:" + quote(address, safe="@+")
+        changed = True
+
+    return str(soup) if changed else html
+
+
