+from io import BytesIO
+from unittest.mock import patch
+from xml.sax.saxutils import escape, quoteattr
+from zipfile import ZipFile
+
+import markdown
+from bs4 import BeautifulSoup
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import SimpleTestCase
+
+from nofos.nofo import parse_uploaded_file_as_html_string
+from nofos.nofo_markdown import md
+
+WORD = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
+OFFICE_RELS = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
+PACKAGE_RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
+DOCX_MIME = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
+
+
+def word_hyperlinks(links):
+    paragraphs = []
+    relationships = []
+    for index, (href, label) in enumerate(links, 1):
+        # Split the address across Word runs and format the first run.
+        paragraphs.append(
+            f'<w:p><w:hyperlink r:id="rId{index}">'
+            f"<w:r><w:rPr><w:b/></w:rPr><w:t>{escape(label[:4])}</w:t></w:r>"
+            f"<w:r><w:t>{escape(label[4:])}</w:t></w:r>"
+            "</w:hyperlink></w:p>"
+        )
+        relationships.append(
+            f'<Relationship Id="rId{index}" Type="{OFFICE_RELS}/hyperlink" '
+            f'Target={quoteattr(href)} TargetMode="External"/>'
+        )
+    output = BytesIO()
+    with ZipFile(output, "w") as docx:
+        docx.writestr(
+            "word/document.xml",
+            f'<w:document xmlns:w="{WORD}" xmlns:r="{OFFICE_RELS}">'
+            f'<w:body>{"".join(paragraphs)}</w:body></w:document>',
+        )
+        docx.writestr(
+            "word/_rels/document.xml.rels",
+            f'<Relationships xmlns="{PACKAGE_RELS}">'
+            f'{"".join(relationships)}</Relationships>',
+        )
+    return SimpleUploadedFile("synthetic-email.docx", output.getvalue(), DOCX_MIME)
+
+
+class WordEmailImportTests(SimpleTestCase):
+    @patch("nofos.nofo.config")
+    def test_rewrites_only_exact_email_file_destinations(self, config):
+        config.WORD_IMPORT_STRICT_MODE = False
+        address = "Help+Grants@example.gov"
+        file_href = "file:///C:/Applicant%20Support/Help%2BGrants%40example.gov"
+        mailto = f"mailto:{address}"
+        links = (
+            (file_href, address, mailto),
+            ("FILE:///tmp/Help+Grants@example.gov", address, mailto),
+            (
+                "file:///tmp/first%23last%40example.gov",
+                "first#last@example.gov",
+                "mailto:first%23last@example.gov",
+            ),
+            (mailto, address, mailto),
+            (
+                "https://example.gov/Help+Grants@example.gov",
+                address,
+                "https://example.gov/Help+Grants@example.gov",
+            ),
+            ("file:///tmp/handbook.pdf", "handbook.pdf", "file:///tmp/handbook.pdf"),
+            (file_href, "help+Grants@example.gov", file_href),
+            (file_href, "Email the grants team", file_href),
+            (f"{file_href}?subject=NOFO", address, f"{file_href}?subject=NOFO"),
+            (f"{file_href}#contact", address, f"{file_href}#contact"),
+            (f"{file_href}?", address, f"{file_href}?"),
+            (f"{file_href}#", address, f"{file_href}#"),
+        )
+        upload = word_hyperlinks([(href, label) for href, label, _ in links])
+
+        html, warnings = parse_uploaded_file_as_html_string(upload)
+
+        self.assertEqual(warnings, 0)
+        for result in (html, markdown.markdown(md(html))):
+            anchors = BeautifulSoup(result, "html.parser").find_all("a")
+            self.assertEqual(
+                [(link["href"], link.get_text()) for link in anchors],
+                [(expected, label) for _, label, expected in links],
+            )
+            self.assertEqual(anchors[0].strong.get_text(), address[:4])
+
+    def test_html_upload_bypasses_repair(self):
+        html = '<a href="file:///tmp/help%40example.gov">help@example.gov</a>'
+        upload = SimpleUploadedFile("example.html", html.encode(), "text/html")
+
+        self.assertEqual(parse_uploaded_file_as_html_string(upload), (html, 0))
