+def _repair_word_email_links(html):
+    """Restore email hyperlinks represented as file URLs in Word."""
+    if "file:" not in html.lower():
+        return html
+
+    soup = BeautifulSoup(html, "html.parser")
+    changed = False
+    for link in soup.find_all("a", href=True):
+        href = link["href"]
+        # Check for delimiters directly, including empty queries and fragments.
+        if not href.lower().startswith("file:") or "?" in href or "#" in href:
+            continue
+        address = link.get_text()
+        try:
+            filename = urlsplit(href).path.rsplit("/", 1)[-1]
+            if unquote(filename, errors="strict") != address or link.find("br"):
+                continue
+            validate_email(address)
+        except (ValidationError, ValueError):
+            continue
+
+        link["href"] = "mailto:" + quote(address, safe="@+")
+        changed = True
+
+    return str(soup) if changed else html
+
