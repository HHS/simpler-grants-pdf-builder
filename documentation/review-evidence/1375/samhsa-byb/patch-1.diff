+    def test_new_word_import_sets_era_for_samhsa_group_or_opdiv(self):
+        for group, opdiv in (
+            ("samhsa", "HRSA"),
+            ("bloom", "Substance Abuse and Mental Health Services Administration"),
+            ("bloom", "HHS (sAmHsA)"),
+        ):
+            with self.subTest(group=group, opdiv=opdiv):
+                self.user.group = group
+                self.user.save(update_fields=["group"])
+                response = self.client.post(
+                    reverse("nofos:nofo_import"),
+                    {"nofo-import": self.upload(opdiv=opdiv)},
+                )
+                nofo = Nofo.objects.latest("created")
+                self.assertRedirects(
+                    response,
+                    reverse("nofos:nofo_import_title", args=[nofo.pk]),
+                    fetch_redirect_response=False,
+                )
+                self.assertEqual(nofo.before_you_begin, "era")
+
+    def test_word_reimport_overrides_samhsa_variant_and_preserves_archive(self):
+        for group, opdiv, number in (
+            ("samhsa", "HHS", "TEST-1096"),
+            ("bloom", "SAMHSA", "TEST-OLD"),
+        ):
+            with self.subTest(group=group, opdiv=opdiv, number=number):
+                nofo = Nofo.objects.create(
+                    title="Existing opportunity",
+                    number=number,
+                    opdiv="HHS",
+                    group=group,
+                    before_you_begin="none",
+                )
+                response = self.client.post(
+                    reverse("nofos:nofo_import_overwrite", args=[nofo.pk]),
+                    {"nofo-import": self.upload(opdiv=opdiv)},
+                )
+                if number != "TEST-1096":
+                    confirm_url = reverse(
+                        "nofos:nofo_import_confirm_overwrite", args=[nofo.pk]
+                    )
+                    self.assertRedirects(
+                        response, confirm_url, fetch_redirect_response=False
+                    )
+                    nofo.refresh_from_db()
+                    self.assertEqual(nofo.before_you_begin, "none")
+                    response = self.client.post(confirm_url)
+                self.assertRedirects(
+                    response,
+                    reverse("nofos:nofo_edit", args=[nofo.pk]),
+                    fetch_redirect_response=False,
+                )
+                nofo.refresh_from_db()
+                self.assertEqual(nofo.before_you_begin, "era")
+                self.assertEqual(
+                    Nofo.objects.get(successor=nofo).before_you_begin, "none"
+                )
+
