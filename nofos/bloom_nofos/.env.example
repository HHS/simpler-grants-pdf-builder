SECRET_KEY="123-fake-key"
DEBUG=1
API_TOKEN=""

# Empty string for DATABASE_URL means it will create and use a local sqlite db
DATABASE_URL=""
DJANGO_ALLOWED_HOSTS=""

DOCRAPTOR_API_KEY="YOUR_API_KEY_HERE"

GRABZIT_APPLICATION_KEY="YOUR_APPLICATION_KEY_HERE"
GRABZIT_APPLICATION_SECRET="YOUR_APPLICATION_SECRET_HERE"

# Uses the hhs-nofo-metrics release pinned in pyproject.toml and poetry.lock.
# This is only the starting value for the HHS_NOFO_METRICS_ENABLED constance
# setting: once that has been saved in the admin, the saved value wins.
HHS_NOFO_METRICS_ENABLED=false
# Optional JSON override for Builder's default presentation targets.
# Leave unset to use the defaults, or set to {} to hide comparisons.
# HHS_NOFO_METRIC_GOALS={}

# Prototype: adds a second export button that strips intact HHS Department
# Governance language and flags anything ambiguous/altered, for faster OMB
# clearance review. This is only the starting value for the
# HHS_NOFO_POLICY_EXPORT_ENABLED constance setting: once that has been saved
# in the admin, the saved value wins.
HHS_NOFO_POLICY_EXPORT_ENABLED=false

# Prototype: structured assistance listing (CFDA) number field, its
# import-time auto-suggestion, and its "Basic information" edit screen.
# These are only the starting values for the
# HHS_NOFO_ASSISTANCE_LISTING_ENABLED / _ON_COVER_ENABLED constance
# settings: once those have been saved in the admin, the saved values win.
HHS_NOFO_ASSISTANCE_LISTING_ENABLED=false
HHS_NOFO_ASSISTANCE_LISTING_ON_COVER_ENABLED=false

LOGIN_GOV_CLIENT_ID=
LOGIN_GOV_OIDC_URL=
LOGIN_GOV_REDIRECT_URI=

GOOGLE_CLOUD_PROJECT=
